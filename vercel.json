{
  "$comment": "SPA rewrites must target / and not /index.html: cleanUrls:true makes /index.html a redirect source, so a rewrite pointing at it resolves to nothing and the route 404s at the edge. Unknown URLs are deliberately left to 404 rather than caught by a catch-all, which would turn every typo into a soft-404 copy of the home page.",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/filtertube-releases.json",
      "destination": "https://filter-tube-52d8e.web.app/releases.json"
    },
    {
      "source": "/api/proxy/:path*",
      "destination": "http://151.145.88.42:3001/:path*"
    },
    {
      "source": "/blog/:slug",
      "destination": "/"
    },
    {
      "source": "/admin",
      "destination": "/"
    },
    {
      "source": "/admin/login",
      "destination": "/"
    },
    {
      "source": "/reset-password",
      "destination": "/"
    },
    {
      "source": "/my-account",
      "destination": "/"
    },
    {
      "source": "/.lovable/oauth/consent",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(?<host>.*\\.vercel\\.app)"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/api/filtertube-releases.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=120, s-maxage=300, stale-while-revalidate=3600"
        }
      ]
    }
  ]
}
